@model Product
<div class="field">
    <label asp-for="Name"></label>
    <input asp-for="Name" class="input" placeholder="Наприклад, Монітор" />
    <span asp-validation-for="Name" class="validation"></span>
</div>
<div class="field">
    <label asp-for="Description"></label>
    <textarea asp-for="Description" class="input" rows="4" placeholder="Короткий опис товару"></textarea>
    <span asp-validation-for="Description" class="validation"></span>
</div>
<div class="grid-two">
    <div class="field">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="input" type="number" min="0.01" max="99999999" step="0.01" value="@(Model.Price == 0 ? "" : Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
        <span asp-validation-for="Price" class="validation"></span>
    </div>
    <div class="field">
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="input">
            <option value="">-- Оберіть категорію --</option>
        </select>
        <span asp-validation-for="CategoryId" class="validation"></span>
    </div>
</div>
